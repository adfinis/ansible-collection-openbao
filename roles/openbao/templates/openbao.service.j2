# {{ ansible_managed }}

[Unit]
Description="OpenBao - A tool for managing secrets"
Documentation=https://github.com/openbao/openbao/tree/main/website/content/docs
Requires=network-online.target
After=network-online.target
ConditionFileNotEmpty={{ openbao_configuration_config_path }}/{{ openbao_configuration_config_file_name }}
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=notify
EnvironmentFile={{ openbao_configuration_config_path }}/{{ openbao_configuration_environment_file_name }}
User={{ openbao_user_name }}
Group={{ openbao_user_group_name }}
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
SecureBits=keep-caps
CapabilityBoundingSet=CAP_SYSLOG
NoNewPrivileges=yes
ExecStart={{ openbao_configuration_runtime_path }}/bao server -config={{ openbao_configuration_config_path }}/{{ openbao_configuration_config_file_name }}
ExecReload=/bin/kill --signal HUP $MAINPID
KillMode=process
KillSignal=SIGINT
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
MemorySwapMax=0

[Install]
WantedBy=multi-user.target
